{
  "expo": {
    "name": "Hometown Ops",
    "slug": "hometown-ops",
    "version": "1.0.0",
    "scheme": "hometownops",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f4c81"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hometown.ops",
      "infoPlist": {
        "NSCameraUsageDescription": "Capture inspection photos",
        "NSPhotoLibraryUsageDescription": "Attach inspection photos from library"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f4c81"
      },
      "package": "com.hometown.ops",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Hometown Ops to use your camera for inspection photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hometown Ops to access photos for inspection evidence."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
